         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>to</photoshop:LayerName>
                  <photoshop:LayerText>to</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Certtificate of Completion</photoshop:LayerName>
                  <photoshop:LayerText>Certtificate of Completion</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Paul Apostol</photoshop:LayerName>
                  <photoshop:LayerText>Paul Apostol</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Founder</photoshop:LayerName>
                  <photoshop:LayerText>Founder</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>for the successful completion of the Digital Skills - Level 1 Program  in which: The participant de</photoshop:LayerName>
                  <photoshop:LayerText>for the successful completion of the Digital Skills - Level 1 Program  in which: The participant developed skills by exploring email applications and studying the netiquette. Became familiar with the basics of the Google Suite (Google Docs and Google Slides) through practice for everyday life usage. Studied financial elements from an online perspective (online banking, online payment methods, online identity protection and financial applications). Researched online identity management (Facebook, Instagram, Twitter and LinkedIn) and acquired basic knowledge about online collaboration tools (Trello and Slack). </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Sunda Sorin Nicolae</photoshop:LayerName>
                  <photoshop:LayerText>Sunda Sorin Nicolae</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>to</photoshop:LayerName>
                  <photoshop:LayerText>to</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Certtificate of Completion</photoshop:LayerName>
                  <photoshop:LayerText>Certtificate of Completion</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Paul Apostol</photoshop:LayerName>
                  <photoshop:LayerText>Paul Apostol</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Founder</photoshop:LayerName>
                  <photoshop:LayerText>Founder</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>for the successful completion of the Digital Skills - Level 2 Program  in which: The participant de</photoshop:LayerName>
                  <photoshop:LayerText>for the successful completion of the Digital Skills - Level 2 Program  in which: The participant developed skills by exploring email applications and studying the netiquette. Became familiar with the basics of the Google Suite (Google Docs and Google Slides) through practice for everyday life usage. Studied financial elements from an online perspective (online banking, online payment methods, online identity protection and financial applications). Researched online identity management (Facebook, Instagram, Twitter and LinkedIn) and acquired basic knowledge about online collaboration tools (Trello and Slack). </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Sunda Sorin Nicolae</photoshop:LayerName>
                  <photoshop:LayerText>Sunda Sorin Nicolae</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>to</photoshop:LayerName>
                  <photoshop:LayerText>to</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Knowledge Certificate </photoshop:LayerName>
                  <photoshop:LayerText>Knowledge Certificate </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Paul Apostol</photoshop:LayerName>
                  <photoshop:LayerText>Paul Apostol</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Founder</photoshop:LayerName>
                  <photoshop:LayerText>Founder</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Gets certified for basic skills in HTML, CSS, PHP and WordPress website administration. The Explore</photoshop:LayerName>
                  <photoshop:LayerText>Gets certified for basic skills in HTML, CSS, PHP and WordPress website administration. The Explorer understands the foundation level concepts that apply in common programming languages.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Sunda Sorin Nicolae</photoshop:LayerName>
                  <photoshop:LayerText>Sunda Sorin Nicolae</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>LEARN TO CODE LEVEL 1</photoshop:LayerName>
                  <photoshop:LayerText>LEARN TO CODE LEVEL 1</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>to</photoshop:LayerName>
                  <photoshop:LayerText>to</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Knowledge Certificate </photoshop:LayerName>
                  <photoshop:LayerText>Knowledge Certificate </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Paul Apostol</photoshop:LayerName>
                  <photoshop:LayerText>Paul Apostol</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Founder</photoshop:LayerName>
                  <photoshop:LayerText>Founder</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Gets certified in the Fundamentals of PHP knowledge sufficient to generate solutions for simple and</photoshop:LayerName>
                  <photoshop:LayerText>         Awarded to the participant for acquiring primary skills in PHP: sufficient knowledge to generate solutions for simple and medium problems, functionalities and web design in PHP. Usage of: variables, control and repetitive structures and functions. Information transfer using GET and POST methods, using Cookies and Sessions, MySQL database design, creating connections between PHP and MySQL and updating the database after user interaction. Understanding syntax, functioning principles and possibilities of HTML and CSS, web pages design at beginner to medium level, using HTML and CSS. </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Sunda Sorin Nicolae</photoshop:LayerName>
                  <photoshop:LayerText>Hanganu Andrei-Marian</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>LEARN TO CODE LEVEL 2</photoshop:LayerName>
                  <photoshop:LayerText>LEARN TO CODE LEVEL 2</photoshop:LayerText>
               </rdf:li>
